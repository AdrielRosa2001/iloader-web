[Unit]
Description=iloader headless server (web UI for sideloading)
Documentation=file:///opt/iloader-server/README-SERVER.md
After=network-online.target usbmuxd.service
Wants=network-online.target

[Service]
Type=simple
User=iloader
Group=iloader
# usbmuxd's socket (/var/run/usbmuxd) is world-writable on Ubuntu; if your
# distro restricts it, add the group that owns it here.
# SupplementaryGroups=plugdev
EnvironmentFile=/etc/iloader-server/env
WorkingDirectory=/opt/iloader-server
ExecStart=/opt/iloader-server/iloader-server
Restart=on-failure
RestartSec=5

# Data lives in /var/lib/iloader-server, scratch in /var/cache/iloader-server
StateDirectory=iloader-server
StateDirectoryMode=0700
CacheDirectory=iloader-server
CacheDirectoryMode=0700
UMask=0077

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# usbmuxd socket
ReadWritePaths=-/var/run/usbmuxd

[Install]
WantedBy=multi-user.target
