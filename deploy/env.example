# /etc/iloader-server/env  (chmod 600, owned by root)

# Address to listen on. Keep 127.0.0.1 when using an SSH tunnel or a reverse
# proxy on the same machine. Use the LAN IP (or 0.0.0.0) only behind TLS.
ILOADER_BIND=127.0.0.1:8080

ILOADER_DATA_DIR=/var/lib/iloader-server
ILOADER_TEMP_DIR=/var/cache/iloader-server
ILOADER_STATIC_DIR=/opt/iloader-server/dist

# Access token. If unset, one is generated on first start in
# $ILOADER_DATA_DIR/access_token (read it with: sudo cat ...).
# ILOADER_TOKEN=change-me-to-a-long-random-string
# ILOADER_TOKEN_FILE=/etc/iloader-server/token

# Enables "save credentials": Apple ID passwords are encrypted with a key
# derived from this file. Without it, passwords are never stored.
# Create with: sudo sh -c 'head -c 32 /dev/urandom | base64 > /etc/iloader-server/secret.key'
# ILOADER_SECRET_KEY_FILE=/etc/iloader-server/secret.key

# Set to 1 when the UI is served over HTTPS (reverse proxy) so the session
# cookie gets the Secure flag.
ILOADER_COOKIE_SECURE=0

# Extra origins allowed to call the API, comma separated (only needed when the
# proxy does not forward the Host header).
# ILOADER_ALLOWED_ORIGINS=https://iloader.lan

# Maximum IPA upload size in MiB.
ILOADER_MAX_UPLOAD_MB=2048

# Level of logs streamed to the web UI: trace, debug, info, warn, error.
ILOADER_UI_LOG_LEVEL=debug

# Talk to a usbmuxd somewhere else (option B, untested): IP:port or socket path.
# USBMUXD_SOCKET_ADDRESS=192.168.0.20:27015
